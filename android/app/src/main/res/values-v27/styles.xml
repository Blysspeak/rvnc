<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- API 27+ (P+ cutout mode is 28, but v27 keeps the file consistent with
         the theme family). Draw under the camera cutout on the short edge so
         the video surface reaches the physical left edge. -->
    <style name="Theme.RVNC" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:colorBackground">#000000</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>
</resources>
